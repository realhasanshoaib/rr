{
  "name": "rr-html",
  "version": "0.3.1",
  "description": "A zero-dependency Node build system for composable HTML documents — compose <rr-*> components into one self-contained HTML file, styled by your own design tokens or the opt-in bundled theme.",
  "type": "module",
  "bin": {
    "rr": "bin/rr.js"
  },
  "files": [
    "bin",
    "src",
    "components",
    "icons.svg",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "cli",
    "html",
    "components",
    "static-site",
    "documents",
    "self-contained",
    "no-dependencies"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hhushhas/rr.git"
  },
  "homepage": "https://rr.hasanshoaib.com",
  "author": "Hasan Shoaib",
  "license": "MIT",
  "devDependencies": {
    "shiki": "^4.3.1"
  }
}
